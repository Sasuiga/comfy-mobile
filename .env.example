# Server
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
# WEB_DIST defaults to the repository's web/dist directory; set it only when
# the built frontend lives somewhere else (relative paths use the process cwd).
# WEB_DIST=./web/dist
LOG_LEVEL=info

# ComfyUI connection. Can also be configured from the web settings page.
COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_TOKEN=
# COMFYUI_HEADERS={"X-API-Key":"..."}
# COMFYUI_INSECURE=false

# Optional shared access token for this web UI.
# AUTH_TOKEN=

# Upload limit in megabytes.
UPLOAD_MAX_MB=20
